Options -Indexes -MultiViews

RewriteEngine On
RewriteBase /

# Never expose development, deployment, test, dependency, or secret material.
RewriteRule ^(?:functions|scripts|tests|scratch|node_modules|dns)(?:/|$) - [R=404,L,NC]
RewriteRule (?:^|/)(?:firebase[^/]*\.(?:json|log)|firestore[^/]*|package[^/]*|playwright[^/]*|README[^/]*|\.env(?:\.[^/]*)?|service-account[^/]*|[^/]+\.(?:py|log))$ - [R=404,L,NC]
RewriteRule ^(?:logs\.txt|FILE_NAME|convert_webp\.js)(?:/)?$ - [R=404,L,NC]

<FilesMatch "(?i)^(?:\.DS_Store|firebase.*\.(?:json|log)|firestore.*|package.*|playwright.*|README.*|\.env(?:\..*)?|service-account.*|.*\.(?:py|log))$">
  Require all denied
</FilesMatch>

# Canonical index URLs (one redirect, including requests that still use .html).
RewriteCond %{THE_REQUEST} "\s/+index(?:\.html)?/?(?:[?\s])" [NC]
RewriteRule ^index(?:\.html)?/?$ https://pmorais.pt/ [R=301,L,NE]

RewriteCond %{THE_REQUEST} "\s/+en/index(?:\.html)?/?(?:[?\s])" [NC]
RewriteRule ^en/index(?:\.html)?/?$ https://pmorais.pt/en/ [R=301,L,NE]

# Redirect public .html requests to their clean canonical URL.
RewriteCond %{THE_REQUEST} "\s/+[^?\s]+\.html(?:[?\s])" [NC]
RewriteRule ^(.+)\.html$ https://pmorais.pt/$1 [R=301,L,NE]

# Enforce the canonical HTTPS origin.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^pmorais\.pt$ [NC]
RewriteRule ^ https://pmorais.pt%{REQUEST_URI} [R=301,L,NE]

# MCP endpoint. mcp.php is a plain file, not a directory: a directory named
# "mcp" makes mod_dir answer POST /mcp with a 301 to /mcp/, which drops the
# JSON-RPC body no matter where this rule sits.
RewriteRule ^mcp/?$ mcp.php [L]

# Markdown for Agents: a request that asks for text/markdown is answered with
# the markdown rendition of the same page, generated into agents/md/ by
# scripts/generate-agent-discovery.mjs. Every other client still gets the HTML.
RewriteCond %{HTTP:Accept} text/markdown [NC]
RewriteCond %{DOCUMENT_ROOT}/agents/md/$1index.md -f
RewriteRule ^(.*/)?$ agents/md/$1index.md [L]

RewriteCond %{HTTP:Accept} text/markdown [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/agents/md/$1.md -f
RewriteRule ^(.+?)/?$ agents/md/$1.md [L]

# Resolve clean URLs to their HTML file without changing the browser URL.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

<IfModule !proxy_fcgi_module>
  <IfModule !php_module>
    <IfModule !mod_php.c>
      <FilesMatch "\.php$">
        Require all denied
      </FilesMatch>
    </IfModule>
  </IfModule>
</IfModule>

# Compress text responses.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/ld+json
  AddOutputFilterByType DEFLATE application/manifest+json application/xml image/svg+xml
  AddOutputFilterByType DEFLATE text/markdown application/linkset+json application/vnd.oai.openapi+json
  AddOutputFilterByType DEFLATE font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

# Long-lived caching for public static assets.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/quicktime "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "\.(?:avif|webp|jpe?g|png|gif|svg|ico|mp4|mov|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML and service workers must always be revalidated.
  <FilesMatch "(?i)^(?:.*\.html?|sw\.js|firebase-messaging-sw\.js)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # RFC 8288 agent discovery. Mirrors LINK_HEADER_RELATIONS in
  # scripts/agent-config.mjs; scripts/check-seo.mjs fails if the two drift.
  # Vary: Accept is required because the same URL also answers text/markdown.
  <FilesMatch "(?i)\.html$">
    Header always append Vary "Accept"
    Header always add Link "</.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\""
    Header always add Link "</openapi.json>; rel=\"service-desc\"; type=\"application/vnd.oai.openapi+json;version=3.1\""
    Header always add Link "</llms-full.txt>; rel=\"service-doc\"; type=\"text/plain\""
    Header always add Link "</llms.txt>; rel=\"describedby\"; type=\"text/plain\""
    Header always add Link "</.well-known/ai-catalog.json>; rel=\"service-meta\"; type=\"application/json\""
    Header always add Link "</.well-known/ai-catalog.json>; rel=\"ai-catalog\"; type=\"application/json\""
    Header always add Link "</.well-known/agent-skills/index.json>; rel=\"describedby\"; type=\"application/json\""
    Header always add Link "</.well-known/mcp/server-card.json>; rel=\"describedby\"; type=\"application/json\""
    Header always add Link "</auth.md>; rel=\"describedby\"; type=\"text/markdown\""
    Header always add Link "</.well-known/oauth-protected-resource>; rel=\"describedby\"; type=\"application/json\""
    Header always add Link "</sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\""
    Header always add Link "</politica-privacidade>; rel=\"privacy-policy\""
    Header always add Link "</termos-e-condicoes>; rel=\"terms-of-service\""
  </FilesMatch>

  # Root-level agent documents. The .well-known, api and agents/md directories
  # carry their own generated .htaccess.
  <Files "openapi.json">
    Header always set Content-Type "application/vnd.oai.openapi+json;version=3.1"
    Header always set Access-Control-Allow-Origin "*"
    Header always set Cache-Control "public, max-age=300, must-revalidate"
  </Files>

  # If no PHP handler is loaded, Apache would hand out mcp.php as a plain file.
  # Deny it instead. (Nothing secret lives in it, but serving source because a
  # handler is missing is a bug, not a feature.)
  <Files "mcp.php">
    Header always set X-Robots-Tag "noindex, nofollow"
  </Files>

  <Files "auth.md">
    Header always set Content-Type "text/markdown; charset=utf-8"
    Header always set Access-Control-Allow-Origin "*"
    Header always set Cache-Control "public, max-age=300, must-revalidate"
  </Files>

  <FilesMatch "(?i)^(?:robots\.txt|llms(?:-full)?\.txt|sitemap\.xml)$">
    Header always set Access-Control-Allow-Origin "*"
  </FilesMatch>

  Header always set Strict-Transport-Security "max-age=86400"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=(), browsing-topics=()"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'nonce-pmorais-2026' 'unsafe-inline' https://www.gstatic.com https://unpkg.com https://cdn.quilljs.com https://www.googletagmanager.com; script-src-attr 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.quilljs.com; style-src-attr 'unsafe-inline'; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; frame-src 'self' https://www.googletagmanager.com https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebasedatabase.app wss://*.firebasedatabase.app https://*.cloudfunctions.net https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://www.googletagmanager.com; worker-src 'self' blob:; manifest-src 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>
